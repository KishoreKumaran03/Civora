DB_HOST=localhost
DB_USER=user
DB_PASSWORD=password
DB_NAME=datavis_db
JWT_SECRET=replace-with-a-strong-secret
PYTHON_BIN=python3
PORT=8000

# Use the IBM watsonx Orchestrate Service instance URL here.
# The backend will append /api/v1/orchestrate/<agent_id>/chat/completions automatically if needed.
WATSONX_ORCHESTRATE_CHAT_URL=https://api.eu-de.watson-orchestrate.cloud.ibm.com/instances/<tenant_id>
WATSONX_ORCHESTRATE_API_KEY=your-api-key
CIVORA_AGENT_ID=your-agent-id
